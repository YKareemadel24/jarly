# ------------------------------------------------------------------
# Saving Jar — environment variables
# Copy this file to `.env` and fill in the real values.
# This file is committed; `.env` is git-ignored. NEVER put real
# credentials in this file — placeholders only.
# NOTE: system environment variables take priority over .env values.
# ------------------------------------------------------------------

# ---- Supabase (auth + database) ----
# Project URL and keys are in the dashboard under Project Settings -> API Keys.
# The publishable key is safe to ship to clients. The secret key is not.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only: bypasses row level security, so it must never leave the server and
# must never be given an EXPO_PUBLIC_ name.
SUPABASE_SECRET_KEY=
# Optional. Only needed for a self-hosted project or a custom auth domain;
# otherwise derived from SUPABASE_URL.
SUPABASE_JWKS_URL=

# ---- Database ----
# Postgres connection string. Use the *Shared Pooler* URI from the project's
# Connect panel — the direct connection is IPv6-only unless the project has the
# IPv4 add-on, which is the usual reason `pnpm db:push` cannot connect.
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ---- Server ----
# Address granted the admin role.
OWNER_EMAIL=
# Comma-separated extra origins allowed to call the API cross-origin (e.g. the
# deployed web build). Loopback dev origins are always allowed. Native apps send
# no Origin header and are unaffected.
ALLOWED_ORIGINS=
# API server port (defaults to 3000).
PORT=3000

# ---- Client (Expo) ----
# scripts/load-env.js maps the SUPABASE_* variables above onto these when they
# are not already set. EXPO_PUBLIC_* values are inlined into the app bundle, so
# never put a secret key in one.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# REQUIRED for production native builds: native cannot derive the API origin
# from a hostname the way web/dev can, and every shared-jar call fails without it.
EXPO_PUBLIC_API_BASE_URL=
# Public origin an invite link should point at, so a link opens for someone who
# does not have the app yet. Defaults to the API origin.
EXPO_PUBLIC_APP_URL=