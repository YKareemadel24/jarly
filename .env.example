# ------------------------------------------------------------------
# Saving Jar — environment variables
# Copy this file to `.env` and fill in the real values.
# NOTE: system environment variables take priority over .env values.
# ------------------------------------------------------------------

# ---- Server ----
# App/project ID; also used as the OAuth client ID.
VITE_APP_ID=

# Manus OAuth server base URL.
OAUTH_SERVER_URL=

# Secret used to sign/verify session JWTs.
JWT_SECRET=

# Open ID of the project owner (granted the `admin` role).
OWNER_OPEN_ID=

# MySQL connection string (required only for Drizzle commands / user table).
# Example: mysql://user:password@localhost:3306/savingjar
DATABASE_URL=

# Forge API (storage/upload) — optional.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# API server port (defaults to 3000).
PORT=3000

# ---- Client (Expo) ----
# scripts/load-env.js maps the VITE_* / OAUTH_* / OWNER_* variables above to
# these EXPO_PUBLIC_* variables when they are not already set.
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=

# Optional override. When unset, the API base URL is derived from the current
# hostname (Metro 8081 -> API 3000).
EXPO_PUBLIC_API_BASE_URL=