# ------------------------------------------------------------------
# Saving Jar — environment variables
# Copy this file to `.env` and fill in the real values.
# This file is committed; `.env` is git-ignored. NEVER put real
# credentials in this file — placeholders only.
# NOTE: system environment variables take priority over .env values.
# ------------------------------------------------------------------

# The app is local-first: every jar lives on the device in AsyncStorage
# and nothing is sent to a server. There are no required variables.
#
# Values prefixed EXPO_PUBLIC_ are inlined into the app bundle, so never
# put a secret in one.

# Optional: public origin used when rendering shareable links.
EXPO_PUBLIC_APP_URL=
